@model Product
<a class="back" asp-action="Index">← обратно към продуктите</a><section class="details"><div class="product-pic big"><img src="~/images/products/product-@Model.Id.jpg" alt="@Model.Name" /></div><div><small>@Model.Category</small><h1>@Model.Name</h1><p>@Model.Description</p><h2>@Model.Price.ToString("0.00") лв.</h2><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" /><button class="buy" type="submit">Добави в количката</button></form><p class="note">* Демонстрационна количка – плащането не е свързано.</p></div></section>
